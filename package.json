{
  "name": "@dada78641/eslint-config",
  "description": "Personal ESLint config",
  "version": "2.1.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./no-semi": {
      "types": "./no-semi.d.ts",
      "default": "./no-semi.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "no-semi.js",
    "no-semi.d.ts",
    "lib/"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dada78641/eslint-config-dada78641.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1"
  }
}
